APP_NAME="Portfolio Nestor KPADJA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nestor.africodehub.net
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# PostgreSQL de production : renseigner la base choisie avant le démarrage.
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=change-this-password
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
PROJECT_MEDIA_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Portfolio Nestor KPADJA"

ADMIN_EMAIL=
ADMIN_PASSWORD=
RUN_DATABASE_SEED=false
